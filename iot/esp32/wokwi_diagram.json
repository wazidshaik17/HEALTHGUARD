{
  "version": 1,
  "author": "HealthGuard AI Innovation Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -120, "left": 120, "attrs": { "temperature": "37", "humidity": "60" } },
    { "type": "wokwi-led", "id": "led1", "top": -60, "left": 0, "attrs": { "color": "green" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": 0, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": 120, "left": 180, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:GND.1", "dht:GND", "black", [ "v0" ] ],
    [ "esp:3V3", "dht:VCC", "red", [ "v0" ] ],
    [ "esp:4", "dht:SDA", "green", [ "v0" ] ],
    [ "esp:2", "r1:1", "cyan", [ "v0" ] ],
    [ "r1:2", "led1:A", "cyan", [ "v0" ] ],
    [ "led1:C", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:18", "bz1:1", "orange", [ "v0" ] ],
    [ "bz1:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
